{
  "name": "mav-collectibles",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:unused": "eslint . --max-warnings 0",
    "postinstall": "prisma generate",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:migration": "supabase migration new",
    "db:check-prisma": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test": "vitest run --project unit --project components",
    "test:watch": "vitest --project unit --project components",
    "test:integration": "vitest run --project integration",
    "build:production": "node scripts/deploy/migrate.mjs && next build"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.107.1",
    "@videojs/http-streaming": "^3.17.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.73.0",
    "next": "^16.4.6",
    "nuqs": "^2.10.3",
    "pg": "^8.23.1",
    "postcss": "^8.5.33",
    "prisma": "^7.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hot-toast": "^2.6.1",
    "react-icons": "^5.7.0",
    "server-only": "^0.0.1",
    "shippo": "^2.19.1",
    "square": "^46.0.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "video.js": "^8.24.2",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.3.0",
    "dotenv": "^18.0.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "jsdom": "^31.0.1",
    "onnxruntime-node": "^1.31.1",
    "supabase": "^3.1.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
