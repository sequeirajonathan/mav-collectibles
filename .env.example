# Copy to .env.local for local development. See ENVIRONMENTS.md for every
# environment's values and where each one is set.
#
# Local values come from `npm run db:start` (printed again by `npx supabase status`).

# ---- Browser-safe (inlined into the client bundle; never put secrets here) ----
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Canonical site URL used in auth emails. Leave empty locally.
NEXT_PUBLIC_SITE_URL=
# Google Maps Embed key (restrict by HTTP referrer in Google Cloud)
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
NEXT_PUBLIC_GOOGLE_PLACE_ID=
NEXT_PUBLIC_MAINTENANCE_MODE=false
NEXT_PUBLIC_DEBUG=false

# ---- Server-only secrets ----
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_SECRET_KEY=
# Catalog source: "fixtures" (tests/fixtures/catalog.json, no Square needed) or "square".
CATALOG_SOURCE=fixtures
# Square: leave the token empty to run without Square (customer linking is skipped).
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
# Comma-separated location IDs for inventory (defaults to the shop's production location).
SQUARE_LOCATION_IDS=
SHIPPO_API_KEY=
# Google Places API key for reviews (server-side; restrict to the Places API)
GOOGLE_PLACES_API_KEY=

# ---- Optional: Google/Facebook sign-in on the local Supabase stack ----
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# SUPABASE_AUTH_EXTERNAL_FACEBOOK_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_FACEBOOK_SECRET=

# ---- Optional: first admin ----
# The account with this confirmed email becomes ADMIN while the site has none.
# BOOTSTRAP_ADMIN_EMAIL=

# ---- Optional: email (Resend) ----
# New job applications are emailed to JOBS_NOTIFY_EMAIL with the résumé attached.
# RESEND_API_KEY=
# EMAIL_FROM="MAV Collectibles <jobs@mavcollectibles.com>"
# JOBS_NOTIFY_EMAIL=

# ---- Optional: staff push notifications ----
# Generate a pair with `npx web-push generate-vapid-keys`.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
