generator client {
  provider        = "prisma-client"
  output          = "../lib/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model FeatureFlag {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  enabled     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("feature_flags")
}

model AlertBanner {
  id              String   @id @default(uuid())
  message         String
  code            String?
  backgroundColor String   @default("#E6B325")
  textColor       String   @default("#000000")
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("alert_banners")
}

model YouTubeSettings {
  id         String   @id @default("1")
  videoId    String
  title      String
  autoplay   Boolean  @default(true)
  muted      Boolean  @default(true)
  playlistId String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("youtube_settings")
}

model VideoSettings {
  id        Int      @id @default(1)
  src       String
  type      String   @default("application/x-mpegURL")
  isLive    Boolean  @default(false)
  poster    String   @default("")
  title     String   @default("Live Stream")
  autoplay  Boolean  @default(true)
  muted     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PrintJob {
  id            String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  order_id      String
  label_url     String
  status        String    @default("pending")
  claimed_by    String?
  claimed_at    DateTime?
  printed_at    DateTime?
  retries       Int       @default(0)
  last_tried_at DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @default(now()) @updatedAt
  copies        Int?      @default(1)

  @@map("print_jobs")
}

model Installer {
  id        String   @id @default(uuid())
  name      String
  url       String
  type      String   @default("github_release")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("installers")
}

// Managed by supabase/migrations (one row per auth user, created by the
// on_auth_user_created trigger).
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Profile {
  id               String   @id @db.Uuid
  username         String?
  first_name       String?
  last_name        String?
  phone            String?
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @default(now()) @db.Timestamptz(6)
  avatar_url       String?
  favorite_game_id String?
  game             Game?    @relation(fields: [favorite_game_id], references: [id], onUpdate: NoAction)

  @@map("profiles")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model EventRegistration {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id      String             @db.Uuid
  user_id       String             @db.Uuid
  status        RegistrationStatus
  note          String?
  answers       Json               @default("{}")
  created_at    DateTime           @default(now()) @db.Timestamptz(6)
  updated_at    DateTime           @default(now()) @db.Timestamptz(6)
  checked_in_at DateTime?          @db.Timestamptz(6)
  event         Event              @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([event_id, user_id])
  @@index([event_id, status, created_at], map: "event_registrations_event_status_idx")
  @@index([user_id], map: "event_registrations_user_idx")
  @@map("event_registrations")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model EventVendor {
  event_id    String            @db.Uuid
  vendor_id   String            @db.Uuid
  status      VendorTableStatus @default(requested)
  table_label String?
  message     String?
  created_at  DateTime          @default(now()) @db.Timestamptz(6)
  event       Event             @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vendor      Vendor            @relation(fields: [vendor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([event_id, vendor_id])
  @@map("event_vendors")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Event {
  id                     String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                   String              @unique
  title                  String
  summary                String              @default("")
  description            String              @default("")
  kind                   EventKind           @default(tournament)
  game_id                String?
  format                 String?
  starts_at              DateTime            @db.Timestamptz(6)
  ends_at                DateTime?           @db.Timestamptz(6)
  location               String              @default("MAV Collectibles")
  link_url               String?
  link_label             String?
  questions              Json                @default("[]")
  cover_image_url        String?
  capacity               Int?
  entry_fee_cents        Int?
  registration_opens_at  DateTime?           @db.Timestamptz(6)
  registration_closes_at DateTime?           @db.Timestamptz(6)
  status                 EventStatus         @default(draft)
  featured               Boolean             @default(false)
  created_by             String?             @db.Uuid
  created_at             DateTime            @default(now()) @db.Timestamptz(6)
  updated_at             DateTime            @default(now()) @db.Timestamptz(6)
  event_registrations    EventRegistration[]
  event_vendors          EventVendor[]
  game                   Game?               @relation(fields: [game_id], references: [id], onUpdate: NoAction)
  posts                  Post[]
  tournament_results     TournamentResult[]

  @@index([game_id], map: "events_game_idx")
  @@index([status, starts_at])
  @@map("events")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Game {
  id         String    @id
  name       String
  short_name String
  color      String    @default("#E6B325")
  sort_order Int       @default(100)
  active     Boolean   @default(true)
  events     Event[]
  posts      Post[]
  profiles   Profile[]
  seasons    Season[]

  @@map("games")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model PostComment {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  post_id    String    @db.Uuid
  user_id    String    @db.Uuid
  body       String
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  deleted_at DateTime? @db.Timestamptz(6)
  deleted_by String?   @db.Uuid
  post       Post      @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([post_id, created_at], map: "post_comments_post_idx")
  @@map("post_comments")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model PostLike {
  post_id    String   @db.Uuid
  user_id    String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  post       Post     @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([post_id, user_id])
  @@map("post_likes")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model PostSave {
  post_id    String   @db.Uuid
  user_id    String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  post       Post     @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([post_id, user_id])
  @@index([user_id, created_at(sort: Desc)], map: "post_saves_user_idx")
  @@map("post_saves")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Post {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title         String
  body          String        @default("")
  image_url     String?
  game_id       String?
  event_id      String?       @db.Uuid
  pinned        Boolean       @default(false)
  status        PostStatus    @default(draft)
  published_at  DateTime?     @db.Timestamptz(6)
  author_id     String?       @db.Uuid
  created_at    DateTime      @default(now()) @db.Timestamptz(6)
  updated_at    DateTime      @default(now()) @db.Timestamptz(6)
  post_comments PostComment[]
  post_likes    PostLike[]
  post_saves    PostSave[]
  event         Event?        @relation(fields: [event_id], references: [id], onUpdate: NoAction)
  game          Game?         @relation(fields: [game_id], references: [id], onUpdate: NoAction)

  @@index([status, pinned(sort: Desc), published_at(sort: Desc)], map: "posts_feed_idx")
  @@map("posts")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Season {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  game_id   String
  name      String
  starts_on DateTime @db.Date
  ends_on   DateTime @db.Date
  game      Game     @relation(fields: [game_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("seasons")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model TournamentResult {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id    String   @db.Uuid
  user_id     String?  @db.Uuid
  player_name String
  placement   Int
  wins        Int      @default(0)
  losses      Int      @default(0)
  draws       Int      @default(0)
  points      Int      @default(0)
  deck        String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  event       Event    @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "tournament_results_user_idx")
  @@map("tournament_results")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Vendor {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug          String        @unique
  name          String
  bio           String        @default("")
  specialties   String        @default("")
  games         String[]      @default([])
  logo_url      String?
  instagram     String?
  website       String?
  contact_email String?
  owner_user_id String?       @unique(map: "vendors_owner_idx", where: raw("(owner_user_id IS NOT NULL)")) @db.Uuid
  status        VendorStatus  @default(pending)
  created_at    DateTime      @default(now()) @db.Timestamptz(6)
  updated_at    DateTime      @default(now()) @db.Timestamptz(6)
  event_vendors EventVendor[]

  @@map("vendors")
}

enum EventKind {
  tournament
  league
  prerelease
  release
  casual
  trade_night
  vendor_day
  special

  @@map("event_kind")
}

enum EventStatus {
  draft
  published
  cancelled
  completed

  @@map("event_status")
}

enum PostStatus {
  draft
  published

  @@map("post_status")
}

enum RegistrationStatus {
  registered
  waitlisted
  checked_in
  cancelled

  @@map("registration_status")
}

enum VendorStatus {
  pending
  approved
  rejected

  @@map("vendor_status")
}

enum VendorTableStatus {
  requested
  confirmed
  declined

  @@map("vendor_table_status")
}

/// Community links shown across the site (Admin → Site).
model CommunitySettings {
  id          Int      @id @default(1) @db.SmallInt
  discord_url String?
  updated_at  DateTime @default(now()) @db.Timestamptz(6)

  @@map("community_settings")
}

/// Cleaned copies of Square product photos (see scripts/images).
model ProductImage {
  square_image_id   String   @id
  path              String
  kind              String
  width             Int
  height            Int
  source_url        String
  background_provider String @default("none")
  processor_version Int
  processed_at      DateTime @default(now()) @db.Timestamptz(6)

  @@map("product_images")
}

/// Proposed/approved replacement photos for card singles (Admin → Photos).
model ImageReplacement {
  square_item_id  String    @id
  square_image_id String?
  item_name       String
  source          String
  source_ref      String
  source_name     String
  source_set      String?
  path            String
  width           Int
  height          Int
  status          String    @default("proposed")
  reviewed_by     String?   @db.Uuid
  reviewed_at     DateTime? @db.Timestamptz(6)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)

  @@index([status, created_at], map: "image_replacements_status_idx")
  @@map("image_replacements")
}

// Feature requests and bug reports from staff (Admin → Requests).
model StaffRequest {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind            String    @default("feature")
  title           String
  details         String    @default("")
  page            String?
  priority        String    @default("normal")
  status          String    @default("new")
  created_by      String    @db.Uuid
  created_by_name String
  response        String    @default("")
  completed_at    DateTime? @db.Timestamptz(6)
  notified_at     DateTime? @db.Timestamptz(6)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @db.Timestamptz(6)

  @@index([status, created_at], map: "staff_requests_status_idx")
  @@index([completed_at], map: "staff_requests_unnotified_idx", where: raw("status = 'done' AND notified_at IS NULL"))
  @@map("staff_requests")
}

// Job applications from /jobs (Admin → Applications).
model JobApplication {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  position     String
  name         String
  email        String
  phone        String   @default("")
  availability String   @default("")
  message      String   @default("")
  resume_path  String?
  resume_name  String?
  status       String   @default("new")
  notes        String   @default("")
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @db.Timestamptz(6)

  @@index([status, created_at], map: "job_applications_status_idx")
  @@index([email, created_at], map: "job_applications_email_idx")
  @@map("job_applications")
}

// Internal staff chat (Admin → Chat).
model StaffMessage {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  author_id   String    @db.Uuid
  author_name String
  body        String    @default("")
  image_path  String?
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  deleted_at  DateTime? @db.Timestamptz(6)

  @@index([created_at(sort: Desc)], map: "staff_messages_created_idx")
  @@map("staff_messages")
}

// Browsers that staff have turned notifications on for.
model PushSubscription {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  endpoint   String   @unique
  p256dh     String
  auth       String
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([user_id], map: "push_subscriptions_user_idx")
  @@map("push_subscriptions")
}

// The shop's own search index, synced from Square (lib/catalog/search-index.ts).
model CatalogSearch {
  item_id         String   @id
  variation_id    String
  variation_ids   String[] @default([])
  name            String
  description     String   @default("")
  sku             String   @default("")
  category_id     String?
  category_name   String?
  image_urls      String[] @default([])
  price_amount    Int      @default(0)
  price_currency  String   @default("USD")
  sold_out        Boolean  @default(false)
  inventory_count Int?
  name_folded     String
  search_text     String
  synced_at       DateTime @default(now()) @db.Timestamptz(6)

  @@index([search_text(ops: raw("gin_trgm_ops"))], map: "catalog_search_text_trgm_idx", type: Gin)
  @@index([name_folded(ops: raw("gin_trgm_ops"))], map: "catalog_search_name_trgm_idx", type: Gin)
  @@map("catalog_search")
}

model CatalogSearchSync {
  id          Int       @id @default(1)
  started_at  DateTime? @db.Timestamptz(6)
  finished_at DateTime? @db.Timestamptz(6)
  item_count  Int       @default(0)
  error       String?

  @@map("catalog_search_sync")
}
